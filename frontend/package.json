{
  "name": "local-chess-trainer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:coach": "vite --config vite.coach.config.ts",
    "build": "tsc -b && npm run test:types && vite build",
    "preview": "vite preview",
    "prebuild": "npm run api:check && node ../scripts/source_archive.mjs",
    "predev": "node ../scripts/source_archive.mjs",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "test:types": "tsc --project tsconfig.contracts.json"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
