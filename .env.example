SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_PATH=data/trainer.sqlite3
STOCKFISH_PATH=stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
STOCKFISH_WORKERS=1
# Processes analyzing different games within one import; each uses STOCKFISH_THREADS.
TRIAGE_DEPTH=10
TRIAGE_TIME=0.15
DEEP_DEPTH=16
DEEP_TIME=0.8
MULTIPV=4
# Optional node limits: TRIAGE_NODES=20000, DEEP_NODES=200000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_ENABLED=false
# Separate concurrent classification requests; increase within your API rate limits.
LLM_WORKERS=2
TARGET_RATING=1500
ACCEPTANCE_MODE=practical
TOLERANCE_CP=50
PRACTICAL_TOLERANCE_CP=100
MISTAKE_THRESHOLD_CP=150
SLOW_ANSWER_SECONDS=30
DESIRED_RETENTION=0.9
MIN_INDEPENDENT_GAMES=2
# Optional shared LAN token. Enter it in the browser's connection form.
LAN_ACCESS_TOKEN=

# Optional Chess.com public game import. No Chess.com API key is needed.
CHESSCOM_TIMEOUT_SECONDS=20
CHESSCOM_MAX_RESPONSE_BYTES=25000000
# You may append contact information to this recognizable User-Agent.
CHESSCOM_USER_AGENT=FieldworkChessTrainer/0.1 (local personal chess training)
