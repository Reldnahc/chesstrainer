{
  "name": "fieldwork-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:coach": "vite --config vite.coach.config.ts",
    "dev:coach:lan": "vite --config vite.coach.config.ts --host 0.0.0.0",
    "dev:intelligence": "vite --config vite.intelligence.config.ts",
    "dev:audio": "vite --config vite.audio.config.ts",
    "dev:audio:lan": "vite --config vite.audio.config.ts --host 0.0.0.0",
    "test:audio": "playwright test --config playwright.audio.config.ts",
    "build:audio-studio": "vite build --config vite.audio.config.ts",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "test:types": "tsc --project tsconfig.contracts.json && tsc --project tsconfig.browser-tests.json",
    "test:styles": "node --test scripts/style-boundaries.test.mjs && node scripts/style-boundaries.mjs && node scripts/spacing-scale.mjs && node scripts/surfaces.mjs && node scripts/type-scale.mjs && node scripts/motion-scale.mjs && node scripts/css-layers.mjs",
    "test:symbols": "node scripts/text-symbols.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gifenc": "1.0.3",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.0"
  }
}
