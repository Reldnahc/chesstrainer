SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_PATH=data/trainer.sqlite3
# Accounts require both ACCOUNTS_ENABLED=true and a nonblank PUBLIC_ORIGIN.
# Blank PUBLIC_ORIGIN selects one local workspace without login, even in Docker.
ACCOUNTS_ENABLED=false
PUBLIC_ORIGIN=
SESSION_SECURE=true
ENGINE_SLOTS=4
STOCKFISH_PATH=stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
STOCKFISH_WORKERS=1
# Concurrent games per training import or moves per game review (1-4).
# Each uses STOCKFISH_THREADS; reviews are also capped by ENGINE_SLOTS.
TRIAGE_DEPTH=10
TRIAGE_TIME=0.15
DEEP_DEPTH=16
DEEP_TIME=0.8
MULTIPV=4
# Optional node limits: TRIAGE_NODES=20000, DEEP_NODES=200000
TARGET_RATING=1500
ACCEPTANCE_MODE=practical
TOLERANCE_CP=50
PRACTICAL_TOLERANCE_CP=100
MISTAKE_THRESHOLD_CP=150
SLOW_ANSWER_SECONDS=30
DESIRED_RETENTION=0.9
# Permanently retire review cards when their scheduled interval exceeds this many days.
RETIRE_AFTER_DAYS=100
MIN_INDEPENDENT_GAMES=2
# Optional shared LAN token. Enter it in the browser's connection form.
LAN_ACCESS_TOKEN=

# Optional Chess.com public game import. No Chess.com API key is needed.
CHESSCOM_TIMEOUT_SECONDS=20
CHESSCOM_MAX_RESPONSE_BYTES=25000000
# You may append contact information to this recognizable User-Agent.
CHESSCOM_USER_AGENT=FieldworkChessTrainer/0.1 (local personal chess training)

# Archived course policy (does not enable lessons)
COURSE_MAX_UNITS=6
LESSON_MAX_POSITIONS=8
LESSON_CHECK_PASS_FRACTION=0.8
# Local rule classification workers (no external model calls).
CLASSIFICATION_WORKERS=2
CLASSIFICATION_MAX_PLIES=16
# Read forward through saved moves when the initial endpoint is still tactical.
CLASSIFICATION_EXTENSION_PLIES=16
# Only attribute patterns within a connected tactical episode of this size.
CLASSIFICATION_TACTIC_PLIES=8
CLASSIFICATION_MIN_LOSS_CP=150
CLASSIFICATION_MIN_MATERIAL=1

# Optional Settings > Deepen unclear positions job, not part of every import.
CLASSIFICATION_PROBE_POSITIONS=40
CLASSIFICATION_PROBE_DEPTH=22
CLASSIFICATION_PROBE_TIME=2.0
# Total searches per selected position, including two root comparisons.
CLASSIFICATION_PROBE_QUERIES=6
