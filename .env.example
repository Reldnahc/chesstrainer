SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_PATH=data/trainer.sqlite3
# Club Study course files; blank keeps them in a courses folder beside the database.
# COURSES_PATH=data/courses
# false: one local workspace without login. true: accounts with sign-in.
# PUBLIC_ORIGIN is optional; set it only if a reverse proxy rewrites the Host header.
ACCOUNTS_ENABLED=false
PUBLIC_ORIGIN=
SESSION_SECURE=true
STOCKFISH_PATH=stockfish
# Optional human-move insights; never changes Stockfish scores or grades.
# Acquire weights explicitly: python -m trainer.human_models.setup
# Docker includes the CPU runtime and uses /data/models/maia3-79m.pt.
HUMAN_MODEL_PATH=data/models/maia3-79m.pt
HUMAN_MODEL_DEVICE=cpu
# Optional folder with a Lichess-layout puzzles CSV and its pinned manifest.
# PUZZLE_PACK_PATH=
# Optional shared LAN token. Enter it in the browser's connection form.
LAN_ACCESS_TOKEN=
# Local mode answers LAN addresses, localhost, short names and .local/.lan names;
# list any other host name here (comma-separated).
ALLOWED_HOSTS=
# Identifies public Chess.com API calls; you may append contact information.
CHESSCOM_USER_AGENT=FieldworkChessTrainer/0.1 (local personal chess training)

# Everything else (engine, human model, review, training, sync, providers and
# classification) is stored in the database. Change it in Settings → Advanced →
# Server and apply it with Restart server. A matching variable added here only
# fills in a setting the database does not have yet; see docs/ADMINISTRATION.md#configuration.
